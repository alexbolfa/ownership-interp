                  [(";", SYMB1);("[", SYMB2);("]", SYMB3);("&", SYMB4);("(", SYMB5);(")", SYMB6);("=", SYMB7);("->", SYMB8);("{", SYMB9);("}", SYMB10);(":", SYMB11);(",", SYMB12);("*", SYMB13);("/", SYMB14);("+", SYMB15);("-", SYMB16);("!", SYMB17);("&&", SYMB18);("||", SYMB19);("==", SYMB20);("<", SYMB21);(">", SYMB22);("<=", SYMB23);(">=", SYMB24)]

